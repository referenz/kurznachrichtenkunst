{
  "name": "kurznachrichtenkunst",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env ./src/main.ts",
    "test": "node --test --experimental-test-module-mocks --no-warnings \"src/test/**/*.test.ts\"",
    "feeds-test": "node --env-file=.env ./src/test/feeds.ts",
    "chatgpt-test": "node --env-file=.env ./src/test/chatGPT.ts",
    "gemini-test": "node --env-file=.env ./src/test/gemini.ts",
    "ai-test": "pnpm chatgpt-test && pnpm gemini-test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "tsc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@atproto/api": "^0.24.3",
    "@google/genai": "^2.28.0",
    "@rowanmanning/feed-parser": "^2.1.5",
    "openai": "^7.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
